<UserControl x:Class="BookWriter.App.BookOutputControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <GroupBox Header="Style" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Headings" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Font:" VerticalAlignment="Center" Margin="0,2,6,2" />
                        <TextBox x:Name="HeadingFontBox" Grid.Row="0" Grid.Column="1" Width="120" Margin="0,2,0,2" Text="Georgia" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Color:" VerticalAlignment="Center" Margin="0,2,6,2" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,2">
                            <TextBox x:Name="HeadingColorBox" Width="80" ToolTip="Hex color, e.g. 1A2B3C. Leave blank for the default color." />
                            <CheckBox x:Name="HeadingBoldCheck" Content="Bold" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Body text" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Font:" VerticalAlignment="Center" Margin="0,2,6,2" />
                        <TextBox x:Name="BodyFontBox" Grid.Row="0" Grid.Column="1" Width="120" Margin="0,2,0,2" Text="Georgia" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Color:" VerticalAlignment="Center" Margin="0,2,6,2" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,2">
                            <TextBox x:Name="BodyColorBox" Width="80" ToolTip="Hex color, e.g. 1A2B3C. Leave blank for the default color." />
                            <CheckBox x:Name="BodyBoldCheck" Content="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal">
            <GroupBox Header="Cover Art" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnGenerateCoverArt" Content="Generate Cover Art" Margin="2" IsEnabled="False"
                            Click="BtnGenerateCoverArt_Click"
                            ToolTip="Generates a KDP-sized (1600x2560) cover illustration with the book's title overlaid, via a 3-tier OpenAI/Gemini/YandexART generative fallback plus an ffmpeg finishing pass." />
                    <Border BorderBrush="{StaticResource MutedTextBrush}" BorderThickness="1" Margin="6,2,2,2" Width="70" Height="112">
                        <Image x:Name="CoverArtImage" Stretch="Uniform" />
                    </Border>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Export">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnExportEpub" Content="Export as EPUB..." Margin="2" IsEnabled="False" Click="BtnExportEpub_Click" />
                    <Button x:Name="BtnExportDocx" Content="Export as Word (.docx)..." Margin="2" IsEnabled="False" Click="BtnExportDocx_Click" />
                    <Button x:Name="BtnExportPdf" Content="Export as PDF..." Margin="2" IsEnabled="False" Click="BtnExportPdf_Click" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <TextBlock x:Name="OutputStatusText" Margin="4,4,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>
</UserControl>
