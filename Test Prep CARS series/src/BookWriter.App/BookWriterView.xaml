<UserControl x:Class="BookWriter.App.BookWriterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BookWriter.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Starter: one free-form idea -> a drafted Setup (title/genre/premise/chapters), all
             still editable below before Write. Optional: fill Setup in by hand and skip this. -->
        <Border Style="{StaticResource PanelBorder}" Grid.Row="0" Margin="4">
            <StackPanel Margin="8">
                <TextBlock Text="Starter prompt (optional)" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StarterPromptBox" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="48" VerticalScrollBarVisibility="Auto"
                             ToolTip="One or two sentences describing the book you want. Book Writer drafts a title, genre, premise and chapter count from it -- all editable below." />
                    <Button x:Name="BtnDraftFromPrompt" Grid.Column="1" Content="Draft setup&#x0a;from prompt"
                            Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Stretch"
                            Click="BtnDraftFromPrompt_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Setup: the raw inputs BookWritingPipeline.WriteAsync needs to plan an outline and
             write every chapter, fully automatically, start to finish. -->
        <Border Style="{StaticResource PanelBorder}" Grid.Row="1" Margin="4">
            <StackPanel Margin="8">
                <TextBlock Text="Setup" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="TitleBox" Grid.Column="1" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Genre:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="GenreCombo" Width="220" />
                    <TextBlock Text="Chapters:" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <TextBox x:Name="ChapterCountBox" Width="60" Text="12" />
                </StackPanel>
                <TextBlock Text="Premise:" Margin="0,0,0,4" />
                <TextBox x:Name="PremiseBox" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="70" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Border>

        <!-- Write toolbar. -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="4">
            <GroupBox Header="Write" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnWriteBook" Content="Write Book" Margin="2"
                            Style="{StaticResource AccentButton}" Click="BtnWriteBook_Click" />
                    <Button x:Name="BtnCancelWrite" Content="Cancel" Margin="6,2,2,2" Visibility="Collapsed"
                            Click="BtnCancelWrite_Click" ToolTip="Cancel the in-progress book generation." />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Retry" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnRetryChapter" Content="Retry This Chapter" Margin="2" IsEnabled="False"
                            Click="BtnRetryChapter_Click" ToolTip="Regenerate just the selected chapter, in place, without rewriting the rest of the book." />
                    <Button x:Name="BtnRetryAllFailed" Content="Retry All Failed" Margin="2" IsEnabled="False"
                            Click="BtnRetryAllFailed_Click" ToolTip="Regenerate every chapter that came back as a failure placeholder." />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Project">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnSaveProject" Content="Save Project..." Margin="2" IsEnabled="False" Click="BtnSaveProject_Click" />
                    <Button x:Name="BtnLoadProject" Content="Load Project..." Margin="2" Click="BtnLoadProject_Click" />
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Status / progress + the shared cover-art / export panel. -->
        <StackPanel Grid.Row="3" Margin="4,0,4,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <ProgressBar x:Name="BusyBar" Width="140" Margin="16,0,0,0" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            </StackPanel>
            <local:BookOutputControls x:Name="OutputControls" />
        </StackPanel>

        <!-- The written book: chapter list on the left, that chapter's full prose on the right. -->
        <Grid Grid.Row="4" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Grid.Column="0" Margin="0,0,4,0">
                <ListBox x:Name="ChaptersListBox" BorderThickness="0" Background="Transparent"
                         SelectionChanged="ChaptersListBox_SelectionChanged" />
            </Border>
            <Border Style="{StaticResource PanelBorder}" Grid.Column="1">
                <TextBox x:Name="ChapterContentBox" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                         Background="Transparent" Padding="6" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
