<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Trimmed down from MediaStar.GPT's own MediaMaker.Core/Theme.xaml when Book Writer was
        spun out into its own standalone app: keeps only the resources BookWriterView.xaml
        actually references, so this app keeps the same visual identity without pulling in the
        original's much larger shared style dictionary.
    -->

    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF3F7FB" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFE5EFF9" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#FFB7CADC" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF17324D" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF5D7287" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2B78C5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF1E5D98" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#FF0067B8" />
    <SolidColorBrush x:Key="AccentSecondaryPressedBrush" Color="#FF004F8E" />

    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSecondaryPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
