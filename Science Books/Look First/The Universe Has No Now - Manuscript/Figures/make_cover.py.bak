"""Simple typographic KDP cover. No NASA, no planets, no fake sky."""
import os
from PIL import Image, ImageDraw, ImageFont

HERE = os.path.dirname(os.path.abspath(__file__))
OUT = os.path.join(HERE, "..", "export", "cover_typographic.jpg")
W, H = 1600, 2560

im = Image.new("RGB", (W, H), (18, 18, 20))
d = ImageDraw.Draw(im)

def load(name, size):
    path = f"C:/Windows/Fonts/{name}"
    return ImageFont.truetype(path, size)

title = load("arialbd.ttf", 88)
sub = load("arial.ttf", 36)  # regular, not italic — italic metrics were eating spaces
by = load("arialbd.ttf", 40)
series = load("arial.ttf", 28)

cream = (236, 230, 216)
mute = (168, 162, 150)
rule = (90, 86, 78)

d.rectangle([80, 80, W - 80, H - 80], outline=rule, width=3)
d.line([(200, 980), (W - 200, 980)], fill=rule, width=2)
d.line([(200, 1680), (W - 200, 1680)], fill=rule, width=2)


def centered_words(y, words, font, fill, gap=28):
    """Draw words left-to-right, centered as a group. Never rely on space glyphs."""
    widths = []
    for w in words:
        box = d.textbbox((0, 0), w, font=font)
        widths.append(box[2] - box[0])
    total = sum(widths) + gap * (len(words) - 1)
    x = (W - total) / 2
    for w, wd in zip(words, widths):
        d.text((x, y), w, font=font, fill=fill, anchor="lm")
        x += wd + gap


centered_words(700, ["THE", "UNIVERSE"], title, cream, gap=36)
centered_words(820, ["HAS", "NO", "NOW"], title, cream, gap=36)
centered_words(1080, ["Time,", "Origins,", "and", "Whether"], sub, mute, gap=18)
centered_words(1145, ["We", "Can", "Get", "Somewhere", "Else"], sub, mute, gap=18)
centered_words(1860, ["LOTHAR", "J.", "MUSIOL"], by, cream, gap=22)
centered_words(1960, ["Look", "First", "·", "Volume", "1"], series, mute, gap=16)

os.makedirs(os.path.dirname(OUT), exist_ok=True)
im.save(OUT, "JPEG", quality=92)
print("wrote", os.path.abspath(OUT), im.size)
