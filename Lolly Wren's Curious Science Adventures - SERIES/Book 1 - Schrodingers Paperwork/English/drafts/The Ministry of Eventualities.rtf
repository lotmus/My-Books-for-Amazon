\par }{\rtlch\fcs1 \ab\af0 \ltrch\fcs0 \b\f0\kerning0\insrsid2375315\charrsid2375315 DOMESTIC CONSOLIDATION VISIT \emdash  RESIDENTIAL CLUSTER 7}{\rtlch\fcs1 \af0 \ltrch\fcs0 \f0\kerning0\insrsid2375315\charrsid2375315 
