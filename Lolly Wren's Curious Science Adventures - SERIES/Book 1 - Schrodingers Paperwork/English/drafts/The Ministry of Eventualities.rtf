\par }\pard \ltrpar\ql \li0\ri0\sb100\sa100\sbauto1\saauto1\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13179129 {\rtlch\fcs1 \af0 \ltrch\fcs0 \f0\kerning0\insrsid13179129\charrsid13179129 
