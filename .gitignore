# Nested repositories with their own history (commit/push them separately)
/Schrodingers_Paperwork/
/Quanta, Actually - SERIES/The Quantum Conversation/The Quantum Conversation - Manuscript/
/Quanta, Actually - SERIES/The Quantum Conversation/quantum-conversation-backup.git/

# Office lock files and temporaries
~$*
*_preview_tmp.pdf
Thumbs.db
desktop.ini
.DS_Store

# Tool caches
__pycache__/
node_modules/

# Over GitHub's 100 MB per-file limit

# leftovers of the damaged first .git (never commit these)
/.git_corrupt/
/.git_corrupt_loose_backup/
/junk/
# Local-only draft snapshots, kept on disk but not tracked
/Lolly Wren's Curious Science Adventures - SERIES/English/drafts/*_BEFORE_*.docx

# Per-book backup/leftover folders (move, never delete; not tracked)
bak/

# Docx-only policy
*.epub
*.pdf
