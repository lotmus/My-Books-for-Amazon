<Window x:Class="GardenBench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Garden Node" Height="360" Width="560">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <ComboBox x:Name="PortBox" Width="100"/>
            <Button x:Name="ConnectButton" Content="Connect" Margin="8,0" Padding="10,2" Click="Connect_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="not connected"/>
        </StackPanel>
        <TextBlock x:Name="ValueText" DockPanel.Dock="Top" FontSize="28" Margin="0,10" Text="--.-- °C"/>
        <Border BorderBrush="Gray" BorderThickness="1">
            <Canvas x:Name="Plot" ClipToBounds="True">
                <Polyline x:Name="TempLine" Stroke="SteelBlue" StrokeThickness="2"/>
            </Canvas>
        </Border>
    </DockPanel>
</Window>
