\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af31507 \ltrch\fcs0 \f3\fs20\kerning2\insrsid14645859 \loch\af3\dbch\af31506\hich\f3 \'b7\tab}Two regions being "connected" in the geometry requires no history of travel between them \emdash 
