\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \ab\af0 \ltrch\fcs0 \f3\fs20\insrsid14645859\charrsid12780743 \loch\af3\dbch\af0\hich\f3 \'b7\tab}}{\rtlch\fcs1 \ab\af0 \ltrch\fcs0 \b\f0\kerning0\insrsid14645859\charrsid12780743 Nuclear efficiency}{\rtlch\fcs1 
